# Docker administrator login. Replace both values before starting.
EXITWISE_ADMIN_EMAIL=admin@example.com
EXITWISE_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-14-characters
EXITWISE_PORT=3000

# Set to your HTTPS origin when placing Exitwise behind a reverse proxy.
# EXITWISE_PUBLIC_URL=https://exitwise.example.com

# Microsoft connection values are entered in Connections > Environment editor.
# Runtime values are also supported as initial defaults (editor settings override them).
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# OFFBOARDING_ADMIN_EMAILS=admin@example.com
# OFFBOARDING_LIVE_ENABLED=false
# OFFBOARDING_PROTECTED_USERS=breakglass@example.com

# Docker automatically creates encryption/session keys in the persistent /data volume.
# For secret mounts, set *_FILE instead of the corresponding direct value.
# EXITWISE_ADMIN_PASSWORD_FILE=/run/secrets/admin_password
